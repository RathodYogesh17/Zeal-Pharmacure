NODE_ENV=production
PORT=5000

# Base URL of backend (used for generated links and fallback asset URLs)
BASE_URL=https://your-backend-domain.com

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://YOUR_MONGO_USERNAME:YOUR_MONGO_PASSWORD@YOUR_CLUSTER.mongodb.net/ZealPharma

# Authentication JWT Secrets & Expiry
JWT_ACCESS_SECRET=generate_a_long_random_secret_here
JWT_REFRESH_SECRET=generate_another_long_random_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=15d

# Allowed Frontend Origins (CORS)
CLIENT_URL=https://zeal-website.vercel.app
ADMIN_URL=https://zeal-admin.vercel.app

# Email SMTP Settings (For enquiry notifications, OTPs, etc.)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=company_email@zealpharma.com
MAIL_PASSWORD=company_email_app_password
MAIL_FROM="Zeal Pharmaceuticals <company_email@zealpharma.com>"
ADMIN_EMAIL=company_admin@zealpharma.com

# WhatsApp & Contact Notifications (Optional)
ADMIN_WHATSAPP=+919876543210
HR_WHATSAPP=+919876543211
HR_PHONE=+919876543211
SALES_MANAGER_WHATSAPP=+919876543212
SALES_PHONE=+919876543212
ENABLE_WHATSAPP_BOT=false

# Cloudinary Cloud Storage (Recommended for cloud deployments like Render/Railway/Vercel)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret